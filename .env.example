# =============================================================
# 디시인사이드 갤러리 모니터링 봇 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# =============================================================

# ---------- 감시 대상 ----------
# 갤러리 ID (URL 의 ?id= 뒤 값)
GALLERY_ID=vaundy0606
# 갤러리 종류: board(정식) | mgallery(마이너) | mini(미니)
GALLERY_TYPE=mgallery
# 감지 키워드 (쉼표로 구분, 자유롭게 추가 가능)
KEYWORDS=취소,취켓팅,양도,풀림
# 제외 키워드 (이 단어가 있으면 알림하지 않음. 예: 구합니다,삽니다)
EXCLUDE_KEYWORDS=
# 매 사이클마다 확인할 리스트 페이지 수
LIST_PAGES=1

# ---------- 알림 채널 (둘 중 하나 이상 필수) ----------
# Discord: 서버 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=
# Telegram: @BotFather 로 봇 생성 후 토큰, @userinfobot 으로 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- 인터파크 예매 링크 ----------
# 공연 상품 코드만 넣으면 자동으로 링크가 만들어집니다 (예: 24012345)
INTERPARK_GOODS_CODE=
# 직접 URL 을 지정하고 싶다면 아래에 입력 (지정 시 GOODS_CODE 보다 우선)
INTERPARK_BOOKING_URL=

# ---------- 크롤링 정책 (IP 차단 방지) ----------
# 사이클 간 대기 시간(초). 무작위로 이 범위에서 결정됩니다.
POLL_MIN_SECONDS=3
POLL_MAX_SECONDS=7
REQUEST_TIMEOUT=10
# 연속 실패 시 최대 백오프(초)
MAX_BACKOFF_SECONDS=300
# 본문까지 확인할지 여부 (false 면 제목만 검사 → 요청 수 감소)
FETCH_BODY=true
# 한 사이클에서 본문을 조회할 최대 글 수
MAX_BODY_FETCH_PER_CYCLE=5
BODY_FETCH_DELAY_MIN=1.0
BODY_FETCH_DELAY_MAX=2.5

# ---------- 상태 캐시 ----------
STATE_FILE=state/last_seen.json
SEEN_HISTORY_SIZE=500
# 최초 실행 시 이미 올라와 있던 글도 알림할지 여부 (기본 false 권장)
NOTIFY_ON_FIRST_RUN=false

# ---------- 기타 ----------
LOG_LEVEL=INFO
# true 면 실제 알림 대신 콘솔에만 출력
DRY_RUN=false
